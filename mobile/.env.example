# Backend REST API base URL (reachable from the device/emulator)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io server URL for live GPS + dispatch messages
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Clerk publishable key (safe to expose in the client bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
